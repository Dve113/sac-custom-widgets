METHOD zodata_sales_tab_read_list.

*&---------------------------------------------------------------------*
*& Lesen der Verkaufsdaten für das SAC Custom Widget
*&
*& Unterstützte OData-Query-Optionen:
*&   $filter
*&   $orderby
*&   $top
*&   $skip
*&   $count
*&   $select
*&---------------------------------------------------------------------*

  TYPES:
    BEGIN OF ts_sales,
      bocordnr   TYPE zodata_salesinformation_basic-bocordnr,
      recordmode TYPE zodata_salesinformation_basic-recordmode,
      bocfahrzg  TYPE zodata_salesinformation_basic-bocfahrzg,
      bocid      TYPE zodata_salesinformation_basic-bocid,
      bocgepa    TYPE zodata_salesinformation_basic-bocgepa,
      calweek    TYPE zodata_salesinformation_basic-calweek,
      calmonth   TYPE zodata_salesinformation_basic-calmonth,
      calquart1  TYPE zodata_salesinformation_basic-calquart1,
      calyear    TYPE zodata_salesinformation_basic-calyear,
      bokdiscnt  TYPE zodata_salesinformation_basic-bokdiscnt,
      boksalepr  TYPE zodata_salesinformation_basic-boksalepr,
      currency   TYPE zodata_salesinformation_basic-currency,
      bocordcnt  TYPE zodata_salesinformation_basic-bocordcnt,
    END OF ts_sales.

  TYPES tt_sales TYPE STANDARD TABLE OF ts_sales WITH EMPTY KEY.

  DATA:
    ls_todo_list TYPE /iwbep/if_v4_requ_basic_list=>ty_s_todo_list,
    ls_done_list TYPE /iwbep/if_v4_requ_basic_list=>ty_s_todo_process_list.

  DATA:
    lt_busi_data TYPE tt_sales,
    lt_where     TYPE string_table,
    lv_where     TYPE string,
    lv_orderby   TYPE string,
    lv_top       TYPE i,
    lv_skip      TYPE i.

  DATA(lt_allowed) = VALUE string_table(
    ( `BOCORDNR`   )
    ( `RECORDMODE` )
    ( `BOCFAHRZG`  )
    ( `BOCID`      )
    ( `BOCGEPA`    )
    ( `CALWEEK`    )
    ( `CALMONTH`   )
    ( `CALQUART1`  )
    ( `CALYEAR`    )
    ( `BOKDISCNT`  )
    ( `BOKSALEPR`  )
    ( `CURRENCY`   )
    ( `BOCORDCNT`  )
  ).

*--------------------------------------------------------------------*
* 1. Vom Framework angeforderte Verarbeitungsschritte lesen
*--------------------------------------------------------------------*
  io_request->get_todos(
    IMPORTING
      es_todo_list = ls_todo_list
  ).

*--------------------------------------------------------------------*
* 2. $filter
*--------------------------------------------------------------------*
IF ls_todo_list-process-filter = abap_true.

  io_request->get_filter_osql_where_clause(
    IMPORTING
      ev_osql_where_clause = lv_where
  ).

  IF lv_where IS NOT INITIAL.
    APPEND lv_where TO lt_where.
  ENDIF.

  ls_done_list-filter = abap_true.

ENDIF.

  " Optional:
  " Technisch gelöschte BW-Sätze ausblenden.
  "
  " APPEND `RECORDMODE NOT IN ( 'R', 'D' )` TO lt_where.



*--------------------------------------------------------------------*
* 3. $orderby
*--------------------------------------------------------------------*
IF ls_todo_list-process-orderby = abap_true.

  io_request->get_orderby(
    IMPORTING
      et_orderby_property = DATA(lt_orderby)
  ).

  LOOP AT lt_orderby INTO DATA(ls_orderby).

    " ABAP_SORTORDER:
    " NAME       = Feldname
    " DESCENDING = X bei absteigender Sortierung
    DATA(lv_field) =
      to_upper( CONV string( ls_orderby-name ) ).

    " Nur erlaubte Datenbankfelder übernehmen.
    " Dadurch gelangen keine unbekannten/dynamisch eingeschleusten
    " Feldnamen in das ORDER BY.
    IF NOT line_exists(
      lt_allowed[ table_line = lv_field ]
    ).
      CONTINUE.
    ENDIF.

    IF lv_orderby IS NOT INITIAL.
      lv_orderby = |{ lv_orderby }, |.
    ENDIF.

    lv_orderby =
      |{ lv_orderby }{ lv_field }{ COND string(
        WHEN ls_orderby-descending = abap_true
        THEN ` DESCENDING`
        ELSE ` ASCENDING`
      ) }|.

  ENDLOOP.

  ls_done_list-orderby = abap_true.

ENDIF.

*--------------------------------------------------------------------*
* Standardsortierung
*--------------------------------------------------------------------*
IF lv_orderby IS INITIAL.
  lv_orderby = `BOCORDNR ASCENDING`.
ENDIF.

*--------------------------------------------------------------------*
* 4. $top
*--------------------------------------------------------------------*
  IF ls_todo_list-process-top = abap_true.

    io_request->get_top(
      IMPORTING
        ev_top = lv_top
    ).

    ls_done_list-top = abap_true.

  ENDIF.

*--------------------------------------------------------------------*
* 5. $skip
*--------------------------------------------------------------------*
  IF ls_todo_list-process-skip = abap_true.

    io_request->get_skip(
      IMPORTING
        ev_skip = lv_skip
    ).

    ls_done_list-skip = abap_true.

  ENDIF.

*--------------------------------------------------------------------*
* 6. $count
*
* Die Anzahl wird vor Anwendung von $top und $skip ermittelt.
*--------------------------------------------------------------------*
IF ls_todo_list-return-count = abap_true.

  SELECT COUNT( * )
    FROM zodata_salesinformation_basic
    WHERE (lt_where)
    INTO @DATA(lv_count).

  io_response->set_count(
    iv_count = CONV #( lv_count )
  ).

ENDIF.

*--------------------------------------------------------------------*
* 7. Daten lesen
*
* Wichtig:
* UP TO 0 ROWS liefert keine Datensätze.
* Deshalb wird UP TO nur verwendet, wenn $top angefordert wurde.
*--------------------------------------------------------------------*
  IF ls_todo_list-process-top = abap_true.

    SELECT bocordnr,
           recordmode,
           bocfahrzg,
           bocid,
           bocgepa,
           calweek,
           calmonth,
           calquart1,
           calyear,
           bokdiscnt,
           boksalepr,
           currency,
           bocordcnt
      FROM zodata_salesinformation_basic
      WHERE (lt_where)
      ORDER BY (lv_orderby)
      INTO CORRESPONDING FIELDS OF TABLE @lt_busi_data
      UP TO @lv_top ROWS
      OFFSET @lv_skip.

  ELSEIF ls_todo_list-process-skip = abap_true.

    SELECT bocordnr,
           recordmode,
           bocfahrzg,
           bocid,
           bocgepa,
           calweek,
           calmonth,
           calquart1,
           calyear,
           bokdiscnt,
           boksalepr,
           currency,
           bocordcnt
      FROM zodata_salesinformation_basic
      WHERE (lt_where)
      ORDER BY (lv_orderby)
      INTO CORRESPONDING FIELDS OF TABLE @lt_busi_data
      OFFSET @lv_skip.

  ELSE.

    SELECT bocordnr,
           recordmode,
           bocfahrzg,
           bocid,
           bocgepa,
           calweek,
           calmonth,
           calquart1,
           calyear,
           bokdiscnt,
           boksalepr,
           currency,
           bocordcnt
      FROM zodata_salesinformation_basic
      WHERE (lt_where)
      ORDER BY (lv_orderby)
      INTO CORRESPONDING FIELDS OF TABLE @lt_busi_data.

  ENDIF.

*--------------------------------------------------------------------*
* 8. Antwort zurückgeben
*--------------------------------------------------------------------*
  io_response->set_busi_data(
    it_busi_data = lt_busi_data
  ).

  io_response->set_is_done(
    ls_done_list
  ).

ENDMETHOD.
